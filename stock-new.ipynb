        "## Section 9 — 30-Day Stock Recommendation Engine\n",
        "Forecasts 30-day future price trajectories using the latest 60 trading days, generating BUY, HOLD, or SELL recommendations based on target gain % and model confidence."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def generate_recommendations(stock_data, prepared_data, trained_models, eval_results, buy_thresh=3.0, sell_thresh=-2.0):\n",
        "    recommendations = []\n",
        "    for ticker in trained_models:\n",
        "        model = trained_models[ticker]\n",
        "        df    = stock_feat[ticker]\n",
        "        X_tr, y_tr, X_te, y_te, scaler_close, scaler_all, feat_names, close_idx = prepared_data[ticker]\n",
        "        ev    = eval_results[ticker]\n",
        "        \n",
        "        latest_60_raw = df.values[-LOOKBACK:]\n",
        "        latest_60_scaled = scaler_all.transform(latest_60_raw)\n",
        "        input_seq = latest_60_scaled.reshape(1, LOOKBACK, latest_60_scaled.shape[1])\n",
        "        \n",
        "        pred_scaled = model.predict(input_seq, verbose=0).flatten()\n",
        "        pred_prices = scaler_close.inverse_transform(pred_scaled.reshape(-1, 1)).flatten()\n",
        "        \n",
        "        current_price = df[\"close\"].iloc[-1]\n",
        "        target_price  = pred_prices[-1]\n",
        "        peak_price    = np.max(pred_prices)\n",
        "        peak_day      = int(np.argmax(pred_prices)) + 1\n",
        "        \n",
        "        gain_pct = ((target_price - current_price) / current_price) * 100.0\n",
        "        \n",
        "        if gain_pct >= buy_thresh:\n",
        "            signal = \"BUY\"\n",
        "        elif gain_pct <= sell_thresh:\n",
        "            signal = \"SELL\"\n",
        "        else:\n",
        "            signal = \"HOLD\"\n",
        "            \n",
        "        dir_acc = ev[\"Dir Accuracy (%)\"]\n",
        "        r2_val  = ev[\"R²\"]\n",
        "        if dir_acc >= 60.0 and r2_val >= 0.70:\n",
        "            confidence = \"High\"\n",
        "        elif dir_acc >= 52.0 or r2_val >= 0.50:\n",
        "            confidence = \"Medium\"\n",
        "        else:\n",
        "            confidence = \"Low\"\n",
        "            \n",
        "        recommendations.append({\n",
        "            \"Stock\": ticker,\n",
        "            \"Signal\": signal,\n",
        "            \"Current\": round(current_price, 2),\n",
        "            \"Target\": round(target_price, 2),\n",
        "            \"Gain%\": round(gain_pct, 1),\n",
        "            \"Peak\": round(peak_price, 2),\n",
        "            \"Peak Day\": f\"{peak_day}d\",\n",
        "            \"Confidence\": confidence,\n",
        "            \"Trajectory\": pred_prices\n",
        "        })\n",
        "        \n",
        "    return pd.DataFrame(recommendations)\n",
        "\n",
        "rec_df = generate_recommendations(stock_data, prepared_data, trained_models, eval_results, BUY_THRESHOLD, SELL_THRESHOLD)"
      ]
