# Section 8: Model Evaluation
add_markdown([
    "## Section 8 — Model Evaluation & Performance Metrics\n",
    "Computes RMSE, MAE, MAPE (%), R² Score, and Directional Accuracy (%) across inverse-transformed real USD stock prices."
])

add_code([
    "def evaluate_stock_model(model, X_test, y_test, scaler_close, ticker):\n",
    "    y_pred_scaled = model.predict(X_test, verbose=0)\n",
    "    y_pred = scaler_close.inverse_transform(y_pred_scaled)\n",
    "    y_true = scaler_close.inverse_transform(y_test)\n",
    "    \n",
    "    rmse = math.sqrt(mean_squared_error(y_true[:, 0], y_pred[:, 0]))\n",
    "    mae  = mean_absolute_error(y_true[:, 0], y_pred[:, 0])\n",
    "    mape = np.mean(np.abs((y_true[:, 0] - y_pred[:, 0]) / (y_true[:, 0] + 1e-8))) * 100\n",
    "    r2   = r2_score(y_true[:, 0], y_pred[:, 0])\n",
    "    \n",
    "    actual_dir    = np.sign(np.diff(y_true[:, 0]))\n",
    "    predicted_dir = np.sign(np.diff(y_pred[:, 0]))\n",
    "    dir_accuracy  = np.mean(actual_dir == predicted_dir) * 100\n",
    "    \n",
    "    return {\n",
    "        \"Ticker\"          : ticker,\n",
    "        \"RMSE (USD)\"      : round(rmse, 4),\n",
    "        \"MAE (USD)\"       : round(mae, 4),\n",
    "        \"MAPE (%)\"        : round(mape, 2),\n",
    "        \"R²\"              : round(r2, 4),\n",
    "        \"Dir Accuracy (%)\": round(dir_accuracy, 1),\n",
    "        \"y_true\"          : y_true,\n",
    "        \"y_pred\"          : y_pred\n",
    "    }\n",
    "\n",
    "eval_results = {}\n",
    "metrics_list = []\n",
    "\n",
    "print(f\"{'Ticker':8s}  {'RMSE (USD)':>10s}  {'MAE (USD)':>10s}  {'MAPE (%)':>9s}  {'R²':>8s}  {'Dir Acc (%)':>12s}\")\n",
    "print(\"-\" * 66)\n",
    "\n",
    "for ticker in trained_models:\n",
    "    model = trained_models[ticker]\n",
    "    X_tr, y_tr, X_test, y_test, scaler_close, *_ = prepared_data[ticker]\n",
    "    res = evaluate_stock_model(model, X_test, y_test, scaler_close, ticker)\n",
    "    eval_results[ticker] = res\n",
    "    metrics_list.append({\n",
    "        \"Ticker\": res[\"Ticker\"],\n",
    "        \"RMSE (USD)\": res[\"RMSE (USD)\"],\n",
    "        \"MAE (USD)\": res[\"MAE (USD)\"],\n",
    "        \"MAPE (%)\": res[\"MAPE (%)\"],\n",
    "        \"R²\": res[\"R²\"],\n",
    "        \"Dir Accuracy (%)\": res[\"Dir Accuracy (%)\"]\n",
    "    })\n",
    "    print(f\"{res['Ticker']:8s}  {res['RMSE (USD)']:>10.4f}  {res['MAE (USD)']:>10.4f}  {res['MAPE (%)']:>8.2f}%  {res['R²']:>8.4f}  {res['Dir Accuracy (%)']:>11.1f}%\")\n",
    "\n",
    "metrics_df = pd.DataFrame(metrics_list)"
      ]
