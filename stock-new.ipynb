# Section 4: Technical Feature Engineering
add_markdown([
    "## Section 4 — Technical Feature Engineering (33 Indicators)\n",
    "Calculates 33 technical financial features capturing trend, momentum, volatility, price distance, volume signals, and autocorrelation lags."
])

add_code([
    "def engineer_stock_features(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\" Computes 33 financial indicators for sequential deep learning models. \"\"\"\n",
    "    feat = pd.DataFrame(index=df.index)\n",
    "    C = df[\"close\"]\n",
    "    H = df[\"high\"]\n",
    "    L = df[\"low\"]\n",
    "    O = df[\"open\"]\n",
    "    V = df[\"volume\"]\n",
    "\n",
    "    # Price Basics\n",
    "    feat[\"open\"]   = O\n",
    "    feat[\"high\"]   = H\n",
    "    feat[\"low\"]    = L\n",
    "    feat[\"close\"]  = C\n",
    "    feat[\"volume\"] = V\n",
    "\n",
    "    # 1. Moving Averages\n",
    "    feat[\"sma_10\"] = C.rolling(10).mean()\n",
    "    feat[\"sma_20\"] = C.rolling(20).mean()\n",
    "    feat[\"sma_50\"] = C.rolling(50).mean()\n",
    "    feat[\"ema_12\"] = C.ewm(span=12, adjust=False).mean()\n",
    "    feat[\"ema_26\"] = C.ewm(span=26, adjust=False).mean()\n",
    "\n",
    "    # 2. Momentum (RSI, MACD, Momentum)\n",
    "    delta = C.diff()\n",
    "    gain  = delta.clip(lower=0).rolling(14).mean()\n",
    "    loss  = (-delta.clip(upper=0)).rolling(14).mean()\n",
    "    rs    = gain / (loss + 1e-8)\n",
    "    feat[\"rsi_14\"] = 100 - (100 / (1 + rs))\n",
    "\n",
    "    feat[\"macd\"]        = feat[\"ema_12\"] - feat[\"ema_26\"]\n",
    "    feat[\"macd_signal\"] = feat[\"macd\"].ewm(span=9, adjust=False).mean()\n",
    "    feat[\"macd_hist\"]   = feat[\"macd\"] - feat[\"macd_signal\"]\n",
    "    feat[\"momentum_10\"] = C - C.shift(10)\n",
    "\n",
    "    # 3. Volatility (Bollinger Bands, ATR, Spread)\n",
    "    bb_mean              = C.rolling(20).mean()\n",
    "    bb_std               = C.rolling(20).std()\n",
    "    feat[\"bb_upper\"]     = bb_mean + 2 * bb_std\n",
    "    feat[\"bb_lower\"]     = bb_mean - 2 * bb_std\n",
    "    feat[\"bb_bandwidth\"] = (feat[\"bb_upper\"] - feat[\"bb_lower\"]) / (bb_mean + 1e-8)\n",
    "    feat[\"bb_position\"]  = (C - feat[\"bb_lower\"]) / (feat[\"bb_upper\"] - feat[\"bb_lower\"] + 1e-8)\n",
    "\n",
    "    tr1 = H - L\n",
    "    tr2 = (H - C.shift(1)).abs()\n",
    "    tr3 = (L - C.shift(1)).abs()\n",
    "    true_range = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1)\n",
    "    feat[\"atr\"] = true_range.rolling(14).mean()\n",
    "    feat[\"hl_spread\"] = (H - L) / (C + 1e-8)\n",
    "\n",
    "    # 4. Price Distances\n",
    "    feat[\"price_vs_sma20\"] = (C - feat[\"sma_20\"]) / (feat[\"sma_20\"] + 1e-8)\n",
    "    feat[\"price_vs_sma50\"] = (C - feat[\"sma_50\"]) / (feat[\"sma_50\"] + 1e-8)\n",
    "\n",
    "    # 5. Volume Signals (OBV, Volume Ratio, Volume Change)\n",
    "    obv = [0]\n",
    "    c_arr = C.values\n",
    "    v_arr = V.values\n",
    "    for i in range(1, len(c_arr)):\n",
    "        if c_arr[i] > c_arr[i-1]:\n",
    "            obv.append(obv[-1] + v_arr[i])\n",
    "        elif c_arr[i] < c_arr[i-1]:\n",
    "            obv.append(obv[-1] - v_arr[i])\n",
    "        else:\n",
    "            obv.append(obv[-1])\n",
    "    feat[\"obv\"] = obv\n",
    "    feat[\"vol_sma20\"]  = V.rolling(20).mean()\n",
    "    feat[\"vol_ratio\"]  = V / (feat[\"vol_sma20\"] + 1e-8)\n",
    "    feat[\"vol_change\"] = V.pct_change()\n",
    "\n",
    "    # 6. Price Lag Features\n",
    "    for lag in [1, 2, 3, 5, 10]:\n",
    "        feat[f\"close_lag{lag}\"] = C.shift(lag)\n",
    "\n",
    "    feat.dropna(inplace=True)\n",
    "    return feat\n",
    "\n",
    "# Engineer features for all stocks\n",
    "stock_feat = {}\n",
    "for ticker, df in stock_data.items():\n",
    "    stock_feat[ticker] = engineer_stock_features(df)\n",
    "    print(f\"  {ticker:6s} : Engineered {stock_feat[ticker].shape[1]} features across {len(stock_feat[ticker]):,} rows\")\n"
])

# Section 5: Dataset Prep
add_markdown([
    "## Section 5 — Data Preparation & Direct Multi-Output Sequence Generation\n",
    "Scales features with `MinMaxScaler` (fitted exclusively on training data) and maps each 60-day sequence `(60, 33)` to the 30-day forecast target vector `(30,)`."
])

add_code([
    "def prepare_multioutput_lstm_data(df: pd.DataFrame, lookback: int, forecast_days: int, train_ratio: float):\n",
    "    feature_names = df.columns.tolist()\n",
    "    close_idx     = feature_names.index(\"close\")\n",
    "    \n",
    "    n_total = len(df)\n",
    "    n_train = int(n_total * train_ratio)\n",
    "    \n",
    "    scaler_all   = MinMaxScaler(feature_range=(0, 1))\n",
    "    scaler_close = MinMaxScaler(feature_range=(0, 1))\n",
    "    \n",
    "    train_vals = df.values[:n_train]\n",
    "    scaler_all.fit(train_vals)\n",
    "    scaler_close.fit(train_vals[:, close_idx].reshape(-1, 1))\n",
    "    \n",
    "    scaled_data = scaler_all.transform(df.values)\n",
    "    \n",
    "    X, Y = [], []\n",
    "    for i in range(lookback, len(scaled_data) - forecast_days + 1):\n",
    "        X.append(scaled_data[i - lookback : i, :])\n",
    "        Y.append(scaled_data[i : i + forecast_days, close_idx])\n",
    "        \n",
    "    X = np.array(X)\n",
    "    Y = np.array(Y)\n",
    "    \n",
    "    split_idx = n_train - lookback\n",
    "    X_train, y_train = X[:split_idx], Y[:split_idx]\n",
    "    X_test,  y_test  = X[split_idx:], Y[split_idx:]\n",
    "    \n",
    "    return X_train, y_train, X_test, y_test, scaler_close, scaler_all, feature_names, close_idx\n",
    "\n",
    "prepared_data = {}\n",
    "for ticker, df in stock_feat.items():\n",
    "    res = prepare_multioutput_lstm_data(df, LOOKBACK, FORECAST_DAYS, TRAIN_RATIO)\n",
    "    prepared_data[ticker] = res\n",
    "    X_tr, y_tr, X_te, y_te = res[:4]\n",
    "    print(f\"  {ticker:6s} : Train X={X_tr.shape}, Y={y_tr.shape} | Test X={X_te.shape}, Y={y_te.shape}\")\n"
])

# Section 6: Model Architecture
add_markdown([
    "## Section 6 — Deep Stacked Bidirectional LSTM Architecture\n",
    "Constructs a stacked Bidirectional LSTM model with Batch Normalization, Dropout, and a 30-unit Dense regression head."
])

add_code([
    "def build_multioutput_stock_lstm(input_shape: tuple, forecast_days: int) -> keras.Model:\n",
    "    inputs = Input(shape=input_shape, name=\"ohlcv_features\")\n",
    "    \n",
    "    x = Bidirectional(LSTM(64, return_sequences=True, dropout=0.1), name=\"bilstm_1\")(inputs)\n",
    "    x = Dropout(0.2, name=\"drop_1\")(x)\n",
    "    \n",
    "    x = Bidirectional(LSTM(32, return_sequences=False, dropout=0.1), name=\"bilstm_2\")(x)\n",
    "    x = BatchNormalization(name=\"batch_norm\")(x)\n",
    "    \n",
    "    x = Dense(64, activation=\"relu\", name=\"dense_1\")(x)\n",
    "    x = Dropout(0.1, name=\"drop_2\")(x)\n",
    "    \n",
    "    output = Dense(forecast_days, name=\"forecast_30d_output\")(x)\n",
    "    \n",
    "    model = Model(inputs=inputs, outputs=output, name=\"StockMultiOutputLSTM\")\n",
    "    model.compile(\n",
    "        optimizer=Adam(learning_rate=1e-3),\n",
    "        loss=\"huber\",\n",
    "        metrics=[\"mae\"]\n",
    "    )\n",
    "    return model\n",
    "\n",
    "sample_ticker = list(prepared_data.keys())[0]\n",
    "sample_Xtr    = prepared_data[sample_ticker][0]\n",
    "sample_model  = build_multioutput_stock_lstm(input_shape=(sample_Xtr.shape[1], sample_Xtr.shape[2]), forecast_days=FORECAST_DAYS)\n",
    "sample_model.summary()\n"
])

# Section 7: Model Training
add_markdown([
    "## Section 7 — Model Training per Stock\n",
    "Trains a dedicated model per stock with `EarlyStopping` and `ReduceLROnPlateau`."
])

add_code([
    "trained_models   = {}\n",
    "training_history = {}\n",
    "\n",
    "for ticker in prepared_data.keys():\n",
    "    X_train, y_train, X_test, y_test, scaler_close, scaler_all, feat_names, close_idx = prepared_data[ticker]\n",
    "    \n",
    "    print(f\"\\n=======================================================\")\n",
    "    print(f\"  Training LSTM Model for Stock: {ticker}\")\n",
    "    print(f\"=======================================================\")\n",
    "    \n",
    "    model = build_multioutput_stock_lstm(input_shape=(X_train.shape[1], X_train.shape[2]), forecast_days=FORECAST_DAYS)\n",
    "    \n",
    "    callbacks = [\n",
    "        EarlyStopping(monitor=\"val_loss\", patience=8, restore_best_weights=True, verbose=0),\n",
    "        ReduceLROnPlateau(monitor=\"val_loss\", factor=0.5, patience=4, min_lr=1e-6, verbose=0)\n",
    "    ]\n",
    "    \n",
    "    history = model.fit(\n",
    "        X_train, y_train,\n",
    "        validation_split=0.15,\n",
    "        epochs=EPOCHS,\n",
    "        batch_size=BATCH_SIZE,\n",
    "        callbacks=callbacks,\n",
